generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  role      String   @default("lawyer")
  createdAt DateTime @default(now())
  cases     Case[]
}

model Case {
  id            String     @id @default(cuid())
  userId        String
  title         String
  caseNumber    String?
  caseType      CaseType
  court         String?
  clientName    String?
  oppositeParty String?
  description   String?
  status        CaseStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum CaseType {
  CIVIL
  CRIMINAL
  CORPORATE
  FAMILY
  PROPERTY
  OTHER
}

enum CaseStatus {
  ACTIVE
  PENDING
  CLOSED
}
